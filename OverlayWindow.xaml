<Window x:Class="ThermalScope.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ThermalScope.Controls"
        Title="ThermalScope overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- The overlay is always dark, whatever theme the app uses: it has to read on top of any game. -->
        <SolidColorBrush x:Key="OverlayText" Color="#F2F5F9" />
        <SolidColorBrush x:Key="OverlayMuted" Color="#9AA5B4" />
        <SolidColorBrush x:Key="OverlayLine" Color="#33FFFFFF" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OverlayMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OverlayText}" />
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Fill" Value="{StaticResource OverlayLine}" />
            <Setter Property="Margin" Value="16,0" />
        </Style>
    </Window.Resources>

    <!-- Content (style, items, opacity) is built in code by OverlayContent from the user's choices. -->
    <Border x:Name="Pill" Margin="10" />
</Window>
